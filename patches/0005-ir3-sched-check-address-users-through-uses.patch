+/* For an instruction that writes a0.x/a1.x: false if it has indirect users
+ * (instructions whose address is this write) and none of them could be
+ * scheduled once it is.
+ *
+ * The indirect users are found through instr->uses (the address is an SSA
+ * source, so every user is in it, and split_addr() fills the uses of the
+ * clones it creates) rather than by scanning ir->a0_users/a1_users, which hold
+ * every indirect instruction of the shader: that scan made each check
+ * O(indirect instructions) and the scheduling of large blocks quadratic.
+ */
+static bool
+addr_users_could_sched(struct ir3_sched_ctx *ctx, struct ir3_instruction *instr)
+{
+   bool has_users = false;
+
+   foreach_ssa_use (indirect, instr) {
+      if (!indirect->address || indirect->address->def != instr->dsts[0])
+         continue;
+      has_users = true;
+      if (could_sched(ctx, indirect, instr))
+         return true;
+   }
+
+   return !has_users;
+}
