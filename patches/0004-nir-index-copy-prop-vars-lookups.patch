+static void
+lookup_check_entry(struct copy_prop_var_state *state,
+                   struct copy_entry *entries, int pos,
+                   nir_deref_and_path *deref,
+                   nir_deref_compare_result allowed_comparisons,
+                   int *first_equal, int *last_match)
+{
+   nir_deref_compare_result result =
+      nir_compare_derefs_and_paths(state->mem_ctx, &entries[pos].dst, deref);
+   if (!(result & allowed_comparisons))
+      return;
+
+   if (result & nir_derefs_equal_bit) {
+      if (*first_equal < 0 || pos < *first_equal)
+         *first_equal = pos;
+   } else if (pos > *last_match) {
+      *last_match = pos;
+   }
+}
+
+/* Same result as the linear search in lookup_entry_for_deref() (the first
+ * equal entry, otherwise the last matching one), comparing the deref only
+ * with the entries that may contain it.
+ */
+static struct copy_entry *
+lookup_entry_in_index(struct copy_prop_var_state *state,
+                      struct copy_array *copies_array,
+                      struct copy_index *index, uint64_t key,
+                      nir_deref_and_path *deref,
+                      nir_deref_compare_result allowed_comparisons,
+                      bool *equal)
+{
+   struct copy_entry *entries = copies_array->entries.data;
+   int first_equal = -1, last_match = -1;
+
+   util_dynarray_foreach(&index->unkeyed, uint32_t, pos) {
+      lookup_check_entry(state, entries, *pos, deref, allowed_comparisons,
+                         &first_equal, &last_match);
+   }
+
+   for (uint32_t pos1 =
+           (uintptr_t)_mesa_hash_table_u64_search(index->chains, key);
+        pos1 != 0; pos1 = entries[pos1 - 1].index_prev) {
+      lookup_check_entry(state, entries, pos1 - 1, deref, allowed_comparisons,
+                         &first_equal, &last_match);
+   }
+
+   if (first_equal >= 0) {
+      if (equal != NULL)
+         *equal = true;
+      return &entries[first_equal];
+   }
+
+   return last_match >= 0 ? &entries[last_match] : NULL;
+}
