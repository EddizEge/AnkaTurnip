+/* Arrays with fewer entries are searched without an index */
+#define COPY_INDEX_MIN_ENTRIES 16
+
+/* Computes the copy_index key of a deref path, see struct copy_index.
+ * Returns false if the path has no key.
+ */
+static bool
+copy_index_key(nir_deref_path *path, uint64_t *key, unsigned *length)
+{
+   unsigned n = 0;
+   while (path->path[n] != NULL)
+      n++;
+
+   nir_deref_instr *root = path->path[0];
+   nir_deref_instr *leaf = path->path[n - 1];
+   if (n < 2 || leaf->deref_type != nir_deref_type_array)
+      return false;
+
+   const bool is_const = nir_src_is_const(leaf->arr.index);
+   const struct {
+      const void *root;
+      uint64_t index;
+      uint32_t length;
+      uint32_t is_const;
+   } k = {
+      .root = root->deref_type == nir_deref_type_var ? (const void *)root->var
+                                                     : (const void *)root,
+      .index = is_const ? nir_src_as_uint(leaf->arr.index)
+                        : (uint64_t)(uintptr_t)leaf->arr.index.ssa,
+      .length = n,
+      .is_const = is_const,
+   };
+
+   /* Different keys may hash the same: that only merges their chains, the
+    * entries in a chain are still compared with the deref.
+    */
+   *key = XXH64(&k, sizeof(k), 0);
+   *length = n;
+   return true;
+}
+
+static void
+copy_index_add(struct copy_prop_var_state *state, struct copy_array *array,
+               unsigned pos)
+{
+   struct copy_index *index = array->index;
+   struct copy_entry *entry =
+      util_dynarray_element(&array->entries, struct copy_entry, pos);
+
+   uint64_t key;
+   unsigned length;
+   if (copy_index_key(nir_get_deref_path(state->mem_ctx, &entry->dst),
+                      &key, &length)) {
+      entry->index_prev =
+         (uintptr_t)_mesa_hash_table_u64_search(index->chains, key);
+      _mesa_hash_table_u64_insert(index->chains, key,
+                                  (void *)(uintptr_t)(pos + 1));
+      index->min_keyed_length = MIN2(index->min_keyed_length, length);
+   } else {
+      util_dynarray_append_typed(&index->unkeyed, uint32_t, pos);
+   }
+}
+
+static struct copy_index *
+copy_index_get(struct copy_prop_var_state *state, struct copy_array *array)
+{
+   if (array->index == NULL) {
+      array->index = ralloc(state->mem_ctx, struct copy_index);
+      array->index->valid = false;
+      array->index->chains = _mesa_hash_table_u64_create(state->mem_ctx);
+      util_dynarray_init(&array->index->unkeyed, state->mem_ctx);
+   }
+
+   struct copy_index *index = array->index;
+   if (!index->valid) {
+      _mesa_hash_table_u64_clear(index->chains);
+      util_dynarray_clear(&index->unkeyed);
+      index->min_keyed_length = UINT_MAX;
+
+      unsigned count =
+         util_dynarray_num_elements(&array->entries, struct copy_entry);
+      for (unsigned pos = 0; pos < count; pos++)
+         copy_index_add(state, array, pos);
+
+      index->valid = true;
+   }
+
+   return index;
+}
+
+static void
+copy_index_invalidate(struct copy_array *array)
+{
+   if (array->index)
+      array->index->valid = false;
+}
