+/* Index over the entries of a copy_array, so that looking up a deref does
+ * not need to compare it with every entry.  Only lookups are indexed: an
+ * entry can only contain (or be equal to) a deref if:
+ *
+ *  - its path is not longer than the deref's path, and
+ *  - when both paths have the same length and end with an array deref, they
+ *    have the same root (variable or cast) and the same index (the same SSA
+ *    value or the same constant).
+ *
+ * (see compare_deref_paths()).  Entries whose path ends with an array deref
+ * are chained by a hash of (root, path length, index); the others are kept
+ * in a list and are always compared.  A deref ending with an array deref is
+ * then only compared with the unkeyed entries and its own chain, provided no
+ * keyed entry has a shorter path.
+ *
+ * The index is built on the first lookup in a large array, kept up to date
+ * when entries are appended and dropped when entries are removed (removal
+ * moves entries around).
+ */
+struct copy_index {
+   bool valid;
+
+   /* Hash key -> 1-based position of the last entry with that key */
+   struct hash_table_u64 *chains;
+
+   /* Positions (uint32_t) of the entries without a key, in array order */
+   struct util_dynarray unkeyed;
+
+   /* Shortest path among the keyed entries */
+   unsigned min_keyed_length;
+};
+
+struct copy_array {
+   struct util_dynarray entries;
+
+   /* NULL until a lookup builds it */
+   struct copy_index *index;
+};
